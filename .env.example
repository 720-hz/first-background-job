# Leave unset (or LLM_STUB=1) to run with no API key at all — the AI call
# is simulated with a realistic delay and a templated report. Set a real
# key and LLM_STUB=0 to have make-report actually call OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
LLM_STUB=1
LLM_TIMEOUT_MS=20000

# Required by the Inngest Dev Server for local (non-cloud) mode.
INNGEST_DEV=1
